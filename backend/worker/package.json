{
  "name": "cyberguard-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:ci": "jest --ci --coverage --detectOpenHandles --forceExit --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "amqplib": "^0.10.3",
    "axios": "^1.14.0",
    "dotenv": "^16.3.1",
    "redis": "^4.6.0",
    "winston": "^3.11.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
